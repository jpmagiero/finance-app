# Use 0.0.0.0 apenas se quiser expor a API na rede local (a API ainda nao tem autenticacao).
HOST=127.0.0.1
PORT=3333
DATABASE_URL=file:./data/app.sqlite

# Origens permitidas no CORS, separadas por virgula.
CORS_ORIGIN=http://localhost:5173

# development | test | production (em production o Swagger UI /docs fica desativado).
NODE_ENV=development

SEED_USER_NAME=Admin
SEED_USER_EMAIL=admin@local
SEED_HOUSEHOLD_NAME=Casa
