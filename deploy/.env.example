# Aponte este nome no DNS da LAN/VPN para o home server.
APP_HOST=finance.localhost
# LAN/VPN: CA interna do Caddy. Clientes precisam confiar no root.crt.
# Dominio publico: use acme e um e-mail real; portas 80/443 precisam ser acessiveis.
TLS_ISSUER=internal
ACME_EMAIL=admin@example.invalid
BACKUP_KEEP=14
BACKUP_INTERVAL_HOURS=24

# Nome do arquivo no volume; restaure sempre para um arquivo novo.
DATABASE_FILE=app.sqlite
